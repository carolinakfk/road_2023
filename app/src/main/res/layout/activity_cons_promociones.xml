<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@layout/back"
    android:orientation="vertical">

    <EditText
        android:id="@+id/txtFiltroPromocion"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="8dp"
        android:hint="Buscar código, producto o promoción"
        android:inputType="text"
        android:paddingStart="12dp"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/txtClientePromocion"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Código de cliente"
            android:inputType="text"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnFiltrarCliente"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:onClick="filtrarPorCliente"
            android:text="Filtrar" />
    </LinearLayout>

    <TextView
        android:id="@+id/lblClientePromocion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:text="Mostrando todas las promociones activas"
        android:textColor="#555555" />

    <TextView
        android:id="@+id/lblSinPromociones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="No hay promociones para mostrar."
        android:textColor="#555555"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPromociones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="#1A8AC6"
        android:gravity="center"
        android:onClick="cerrarPromociones"
        android:text="Salir"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>
