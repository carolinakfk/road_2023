<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/promotion_item_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lblPromoCodigo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1A8AC6"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblPromoTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="#E6F3F9"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="#006A9E"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/lblPromoProducto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#222222"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/lblPromoNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#444444"
        android:textStyle="italic" />

    <TextView
        android:id="@+id/lblPromoValores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="#222222" />

    <TextView
        android:id="@+id/lblPromoModalidad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#555555" />

    <TextView
        android:id="@+id/lblPromoVigencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#555555" />

    <TextView
        android:id="@+id/lblVerCombo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="Ver productos del combo ▼"
        android:textColor="#1A8AC6"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/lblDetalleCombo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#F4F4F4"
        android:padding="8dp"
        android:textColor="#222222"
        android:visibility="gone" />

</LinearLayout>
